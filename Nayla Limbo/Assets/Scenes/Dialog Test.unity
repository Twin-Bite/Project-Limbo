--- !u!114 &1263684772
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1263684771}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3c4a232f1b87b04ba7fa5d4567b9b8a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cutsceneData:
  - name: 1
    charactersData: []
    propsData: []
    nameString: Nayla
    chatString: Halo, Ibu. Nayla udah pulang, kok pintunya terkunci?
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
  - name: 2
    charactersData: []
    propsData: []
    nameString: Ibu
    chatString: Maaf sayang, Ibu lupa kabarin Nayla. Ibu harus antar Ayah dinas ke
      Singapura sampai hari minggu.
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
  - name: 3
    charactersData: []
    propsData: []
    nameString: Nayla
    chatString: Lho, kok dadakan banget bu?
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
  - name: 4
    charactersData: []
    propsData: []
    nameString: Ibu
    chatString: Nggak tau nih, bossnya Ayah baru ngabarin pagi ini juga.
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
  - name: 5
    charactersData: []
    propsData: []
    nameString: Ibu
    chatString: Maaf ya Nayla, nanti ibu bawakan oleh-oleh yang banyak.
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
  - name: 6
    charactersData: []
    propsData: []
    nameString: Ibu
    chatString: Kita udah mau sampai bandara, nanti Ibu telpon lagi kalau sudah sampai
      Singapura
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
  - name: 7
    charactersData: []
    propsData: []
    nameString: Nayla
    chatString: (Menghela napas) Oke deh, kalian hati hati ya.
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
  - name: 8
    charactersData: []
    propsData: []
    nameString: Ibu
    chatString: Makasih sayang, We love you~
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
  - name: 9
    charactersData: []
    propsData: []
    nameString: Ibu
    chatString: Oh iya, kuncinya ada <color=red>di bawah pot bunga</color>.
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 216241811}
          m_TargetAssemblyTypeName: FadeBehaviour, Assembly-CSharp
          m_MethodName: BeginFadingIn
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  currentID: 0
  charaNameText: {fileID: 405993971}
  chatText: {fileID: 946687380}
